<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>

<!--
    discussion-forum.fxml  (STUDENT VIEW)
    Root is BorderPane so it fills the full available height when placed
    directly into the dashboard's rootPane center region.
    Controller: DiscussionForumController
-->
<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.examverse.controller.forum.DiscussionForumController"
            style="-fx-background-color: #0a1020;">

    <!-- ── TOP: header bar ──────────────────────────────────────────────── -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="12"
              style="-fx-background-color: #0d1525;
                     -fx-border-color: transparent transparent #1e3a5a transparent;
                     -fx-border-width: 0 0 1 0;
                     -fx-padding: 18 28 18 28;">
            <Label text="💬" style="-fx-font-size: 24px;"/>
            <VBox spacing="2">
                <Label text="Discussion Forum"
                       style="-fx-text-fill: #e2e8f0; -fx-font-size: 20px; -fx-font-weight: 700;"/>
                <Label text="Chat live with classmates and teachers"
                       style="-fx-text-fill: #475569; -fx-font-size: 12px;"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <HBox alignment="CENTER" spacing="6"
                  style="-fx-background-color: rgba(6,182,212,0.1);
                         -fx-border-color: rgba(6,182,212,0.3);
                         -fx-border-width: 1; -fx-border-radius: 20; -fx-background-radius: 20;
                         -fx-padding: 5 14 5 14;">
                <Circle radius="4" style="-fx-fill: #22c55e;"/>
                <Label text="# general  •  LIVE"
                       style="-fx-text-fill: #06b6d4; -fx-font-size: 11px; -fx-font-weight: 700;"/>
            </HBox>
        </HBox>
    </top>

    <!-- ── CENTER: chat panel + online sidebar ──────────────────────────── -->
    <center>
        <HBox spacing="0" style="-fx-padding: 20 24 20 24; -fx-background-color: transparent;">

            <!-- Chat panel -->
            <VBox HBox.hgrow="ALWAYS" spacing="0"
                  style="-fx-background-color: #0d1525;
                         -fx-border-color: #1e3a5a;
                         -fx-border-width: 1;
                         -fx-border-radius: 16 0 0 16;
                         -fx-background-radius: 16 0 0 16;">

                <HBox alignment="CENTER_LEFT" spacing="10"
                      style="-fx-padding: 14 20 14 20;
                             -fx-background-color: #0a1828;
                             -fx-background-radius: 16 0 0 0;
                             -fx-border-color: transparent transparent #1e3a5a transparent;
                             -fx-border-width: 0 0 1 0;">
                    <Circle radius="5" style="-fx-fill: #22c55e;"/>
                    <Label text="# general"
                           style="-fx-text-fill: #06b6d4; -fx-font-size: 14px; -fx-font-weight: 700;"/>
                    <Label text="—  open to everyone"
                           style="-fx-text-fill: #334155; -fx-font-size: 11px;"/>
                </HBox>

                <ScrollPane fx:id="messagesScroll"
                            fitToWidth="true" VBox.vgrow="ALWAYS" hbarPolicy="NEVER"
                            style="-fx-background-color: transparent;
                                   -fx-background: transparent;
                                   -fx-border-color: transparent;">
                    <VBox fx:id="messagesBox" spacing="4"
                          style="-fx-background-color: transparent; -fx-padding: 14 0 14 0;"/>
                </ScrollPane>

                <HBox spacing="10" alignment="CENTER"
                      style="-fx-padding: 12 16 12 16;
                             -fx-background-color: #0a1525;
                             -fx-background-radius: 0 0 0 16;
                             -fx-border-color: #1e3a5a transparent transparent transparent;
                             -fx-border-width: 1 0 0 0;">
                    <TextField fx:id="inputField"
                               promptText="Write a message to the forum…"
                               HBox.hgrow="ALWAYS"
                               style="-fx-background-color: #111d30;
                                      -fx-text-fill: #e2e8f0;
                                      -fx-prompt-text-fill: #2d4060;
                                      -fx-border-color: #1e3a5a;
                                      -fx-border-width: 1;
                                      -fx-border-radius: 10;
                                      -fx-background-radius: 10;
                                      -fx-font-size: 13px;
                                      -fx-padding: 11 16 11 16;"/>
                    <Button fx:id="sendBtn" text="➤"
                            style="-fx-background-color: linear-gradient(to right,#06b6d4,#0891b2);
                                   -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold;
                                   -fx-background-radius: 10; -fx-cursor: hand; -fx-padding: 10 20;
                                   -fx-effect: dropshadow(gaussian,#06b6d460,10,0.4,0,2);"/>
                </HBox>
            </VBox>

            <!-- Online sidebar -->
            <VBox prefWidth="220" minWidth="200"
                  style="-fx-background-color: #080f1e;
                         -fx-border-color: #1e3a5a;
                         -fx-border-width: 1 1 1 0;
                         -fx-border-radius: 0 16 16 0;
                         -fx-background-radius: 0 16 16 0;">

                <HBox alignment="CENTER_LEFT" spacing="8"
                      style="-fx-padding: 14 16 14 16;
                             -fx-background-color: #0a1828;
                             -fx-background-radius: 0 16 0 0;
                             -fx-border-color: transparent transparent #1e3a5a transparent;
                             -fx-border-width: 0 0 1 0;">
                    <Label text="👥" style="-fx-font-size: 13px;"/>
                    <Label text="Online"
                           style="-fx-text-fill: #94a3b8; -fx-font-size: 12px; -fx-font-weight: 700;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="onlineCountLabel" text="0 online"
                           style="-fx-text-fill: #22c55e; -fx-font-size: 10px; -fx-font-weight: 700;
                                  -fx-padding: 2 8 2 8;
                                  -fx-background-color: rgba(34,197,94,0.12);
                                  -fx-background-radius: 10;
                                  -fx-border-color: rgba(34,197,94,0.3);
                                  -fx-border-width: 1; -fx-border-radius: 10;"/>
                </HBox>

                <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" hbarPolicy="NEVER"
                            style="-fx-background-color: transparent;
                                   -fx-background: transparent; -fx-border-color: transparent;">
                    <VBox fx:id="onlineUsersBox" spacing="2"
                          style="-fx-background-color: transparent; -fx-padding: 8 4 8 4;"/>
                </ScrollPane>

                <!-- Rank legend -->
                <VBox spacing="5"
                      style="-fx-padding: 12 14 16 14;
                             -fx-border-color: #1e3a5a transparent transparent transparent;
                             -fx-border-width: 1 0 0 0;
                             -fx-background-color: #060c18;
                             -fx-background-radius: 0 0 16 0;">
                    <Label text="RANK COLOURS"
                           style="-fx-text-fill: #1e3a5a; -fx-font-size: 9px; -fx-font-weight: 700;"/>
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <Circle radius="5" style="-fx-fill: #fbbf24;"/>
                        <Label text="Legend" style="-fx-text-fill: #334155; -fx-font-size: 11px;"/>
                    </HBox>
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <Circle radius="5" style="-fx-fill: #a78bfa;"/>
                        <Label text="Champion" style="-fx-text-fill: #334155; -fx-font-size: 11px;"/>
                    </HBox>
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <Circle radius="5" style="-fx-fill: #60a5fa;"/>
                        <Label text="Expert" style="-fx-text-fill: #334155; -fx-font-size: 11px;"/>
                    </HBox>
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <Circle radius="5" style="-fx-fill: #f97316;"/>
                        <Label text="Advanced" style="-fx-text-fill: #334155; -fx-font-size: 11px;"/>
                    </HBox>
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <Circle radius="5" style="-fx-fill: #34d399;"/>
                        <Label text="Skilled" style="-fx-text-fill: #334155; -fx-font-size: 11px;"/>
                    </HBox>
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <Circle radius="5" style="-fx-fill: #94a3b8;"/>
                        <Label text="Learner" style="-fx-text-fill: #334155; -fx-font-size: 11px;"/>
                    </HBox>
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <Circle radius="5" style="-fx-fill: #6b7280;"/>
                        <Label text="Beginner" style="-fx-text-fill: #334155; -fx-font-size: 11px;"/>
                    </HBox>
                </VBox>
            </VBox>
        </HBox>
    </center>

</BorderPane>
