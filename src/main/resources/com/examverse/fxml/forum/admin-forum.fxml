<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>

<!--
    admin-forum.fxml  (ADMIN VIEW)
    Root is BorderPane — fills full height when set as rootPane.center.
    TabPane background is fully overridden via inline styles on every
    structural node to defeat JavaFX Modena's white defaults.
    Controller: AdminForumController
-->
<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.examverse.controller.forum.AdminForumController"
            style="-fx-background-color: #0a1020;">

    <!-- ── TOP: header ──────────────────────────────────────────────────── -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="12"
              style="-fx-background-color: #0d1525;
                     -fx-border-color: transparent transparent #1e2231 transparent;
                     -fx-border-width: 0 0 1 0;
                     -fx-padding: 18 28 18 28;">
            <Label text="💬" style="-fx-font-size: 24px;"/>
            <VBox spacing="2">
                <Label text="Discussion Forum"
                       style="-fx-text-fill: #e2e8f0; -fx-font-size: 20px; -fx-font-weight: 700;"/>
                <Label text="Manage conversations with admins and students"
                       style="-fx-text-fill: #475569; -fx-font-size: 12px;"/>
            </VBox>
        </HBox>
    </top>

    <!-- ── CENTER: TabPane filling all remaining height ─────────────────── -->
    <center>
        <!--
            JavaFX Modena paints several internal TabPane regions white.
            We override EVERY level:
              TabPane itself       → -fx-background-color
              .tab-header-area     → handled via TabPane style
              .tab-content-area    → handled via TabPane style
            The actual HBox content inside each tab also has explicit dark
            backgrounds so nothing ever shows white.
        -->
        <TabPane fx:id="tabPane"
                 tabClosingPolicy="UNAVAILABLE"
                 style="-fx-background-color: #0a1020;
                        -fx-tab-header-background: #0d1525;
                        -fx-tab-min-width: 170px;
                        -fx-padding: 0;">

            <!-- ══════════════════════════════════════════════════════
                 TAB 1 — Admin Chat  (ADMIN channel, gold accent)
                 ══════════════════════════════════════════════════════ -->
            <Tab fx:id="adminChatTab" text="🔒  Admin Chat">
                <!--
                    Tab content background MUST be set here on the root node
                    of the tab content, not on the Tab element itself, because
                    JavaFX injects its own .tab-content-area pane between them.
                    Setting background on the content root node covers it fully.
                -->
                <BorderPane style="-fx-background-color: #0a1020; -fx-padding: 16 24 16 24;">

                    <center>
                        <HBox spacing="0">

                            <!-- Chat panel — gold/amber accent for admin-only -->
                            <VBox HBox.hgrow="ALWAYS" spacing="0"
                                  style="-fx-background-color: #0d1420;
                                         -fx-border-color: #3b2a00;
                                         -fx-border-width: 1;
                                         -fx-border-radius: 16 0 0 16;
                                         -fx-background-radius: 16 0 0 16;">

                                <HBox alignment="CENTER_LEFT" spacing="10"
                                      style="-fx-padding: 14 20 14 20;
                                             -fx-background-color: #0e1608;
                                             -fx-background-radius: 16 0 0 0;
                                             -fx-border-color: transparent transparent #3b2a00 transparent;
                                             -fx-border-width: 0 0 1 0;">
                                    <Circle radius="5" style="-fx-fill: #f59e0b;"/>
                                    <Label text="# admin-only"
                                           style="-fx-text-fill: #f59e0b; -fx-font-size: 14px; -fx-font-weight: 700;"/>
                                    <Label text="—  visible only to admins and teachers"
                                           style="-fx-text-fill: #334155; -fx-font-size: 11px;"/>
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <HBox alignment="CENTER" spacing="6"
                                          style="-fx-background-color: rgba(245,158,11,0.1);
                                                 -fx-border-color: rgba(245,158,11,0.3);
                                                 -fx-border-width: 1; -fx-border-radius: 20;
                                                 -fx-background-radius: 20; -fx-padding: 3 10 3 10;">
                                        <Circle radius="4" style="-fx-fill: #f59e0b;"/>
                                        <Label text="ADMIN ONLY"
                                               style="-fx-text-fill: #f59e0b; -fx-font-size: 10px; -fx-font-weight: 700;"/>
                                    </HBox>
                                </HBox>

                                <ScrollPane fx:id="adminMessagesScroll"
                                            fitToWidth="true" VBox.vgrow="ALWAYS" hbarPolicy="NEVER"
                                            style="-fx-background-color: transparent;
                                                   -fx-background: transparent;
                                                   -fx-border-color: transparent;">
                                    <VBox fx:id="adminMessagesBox" spacing="4"
                                          style="-fx-background-color: transparent; -fx-padding: 14 0 14 0;"/>
                                </ScrollPane>

                                <HBox spacing="10" alignment="CENTER"
                                      style="-fx-padding: 12 16 12 16;
                                             -fx-background-color: #0a0e18;
                                             -fx-background-radius: 0 0 0 16;
                                             -fx-border-color: #3b2a00 transparent transparent transparent;
                                             -fx-border-width: 1 0 0 0;">
                                    <TextField fx:id="adminInputField"
                                               promptText="Message other admins…"
                                               HBox.hgrow="ALWAYS"
                                               style="-fx-background-color: #111620;
                                                      -fx-text-fill: #e2e8f0;
                                                      -fx-prompt-text-fill: #2d3040;
                                                      -fx-border-color: #3b2a00;
                                                      -fx-border-width: 1;
                                                      -fx-border-radius: 10;
                                                      -fx-background-radius: 10;
                                                      -fx-font-size: 13px;
                                                      -fx-padding: 11 16 11 16;"/>
                                    <Button fx:id="adminSendBtn" text="➤"
                                            style="-fx-background-color: linear-gradient(to right,#f59e0b,#d97706);
                                                   -fx-text-fill: #0a0500; -fx-font-size: 14px;
                                                   -fx-font-weight: bold; -fx-background-radius: 10;
                                                   -fx-cursor: hand; -fx-padding: 10 20;
                                                   -fx-effect: dropshadow(gaussian,#f59e0b60,10,0.4,0,2);"/>
                                </HBox>
                            </VBox>

                            <!-- Online sidebar — admins only -->
                            <VBox prefWidth="220" minWidth="200"
                                  style="-fx-background-color: #080c14;
                                         -fx-border-color: #3b2a00;
                                         -fx-border-width: 1 1 1 0;
                                         -fx-border-radius: 0 16 16 0;
                                         -fx-background-radius: 0 16 16 0;">

                                <HBox alignment="CENTER_LEFT" spacing="8"
                                      style="-fx-padding: 14 16 14 16;
                                             -fx-background-color: #0e1608;
                                             -fx-background-radius: 0 16 0 0;
                                             -fx-border-color: transparent transparent #3b2a00 transparent;
                                             -fx-border-width: 0 0 1 0;">
                                    <Label text="🛡️" style="-fx-font-size: 12px;"/>
                                    <Label text="Admins Online"
                                           style="-fx-text-fill: #f59e0b; -fx-font-size: 12px; -fx-font-weight: 700;"/>
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Label fx:id="adminOnlineCount" text="0 online"
                                           style="-fx-text-fill: #22c55e; -fx-font-size: 10px; -fx-font-weight: 700;
                                                  -fx-padding: 2 8 2 8;
                                                  -fx-background-color: rgba(34,197,94,0.12);
                                                  -fx-background-radius: 10;
                                                  -fx-border-color: rgba(34,197,94,0.3);
                                                  -fx-border-width: 1; -fx-border-radius: 10;"/>
                                </HBox>

                                <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" hbarPolicy="NEVER"
                                            style="-fx-background-color: transparent;
                                                   -fx-background: transparent; -fx-border-color: transparent;">
                                    <VBox fx:id="adminOnlineBox" spacing="2"
                                          style="-fx-background-color: transparent; -fx-padding: 8 4 8 4;"/>
                                </ScrollPane>

                                <VBox spacing="6"
                                      style="-fx-padding: 12 14 14 14;
                                             -fx-border-color: #3b2a00 transparent transparent transparent;
                                             -fx-border-width: 1 0 0 0;
                                             -fx-background-color: #060810;
                                             -fx-background-radius: 0 0 16 0;">
                                    <Label text="🔒  Admin-only channel"
                                           style="-fx-text-fill: #f59e0b; -fx-font-size: 11px; -fx-font-weight: 600;"/>
                                    <Label text="Students cannot see or\nsend messages here."
                                           style="-fx-text-fill: #334155; -fx-font-size: 10px;"
                                           wrapText="true"/>
                                </VBox>
                            </VBox>
                        </HBox>
                    </center>
                </BorderPane>
            </Tab>

            <!-- ══════════════════════════════════════════════════════
                 TAB 2 — Student Forum  (GENERAL channel, cyan accent)
                 ══════════════════════════════════════════════════════ -->
            <Tab fx:id="studentChatTab" text="🌐  Student Forum">
                <BorderPane style="-fx-background-color: #0a1020; -fx-padding: 16 24 16 24;">

                    <center>
                        <HBox spacing="0">

                            <!-- Chat panel — cyan accent, same as student view -->
                            <VBox HBox.hgrow="ALWAYS" spacing="0"
                                  style="-fx-background-color: #0d1525;
                                         -fx-border-color: #1e3a5a;
                                         -fx-border-width: 1;
                                         -fx-border-radius: 16 0 0 16;
                                         -fx-background-radius: 16 0 0 16;">

                                <HBox alignment="CENTER_LEFT" spacing="10"
                                      style="-fx-padding: 14 20 14 20;
                                             -fx-background-color: #0a1828;
                                             -fx-background-radius: 16 0 0 0;
                                             -fx-border-color: transparent transparent #1e3a5a transparent;
                                             -fx-border-width: 0 0 1 0;">
                                    <Circle radius="5" style="-fx-fill: #22c55e;"/>
                                    <Label text="# general"
                                           style="-fx-text-fill: #06b6d4; -fx-font-size: 14px; -fx-font-weight: 700;"/>
                                    <Label text="—  shared with all students"
                                           style="-fx-text-fill: #334155; -fx-font-size: 11px;"/>
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <HBox alignment="CENTER" spacing="6"
                                          style="-fx-background-color: rgba(239,68,68,0.1);
                                                 -fx-border-color: rgba(239,68,68,0.3);
                                                 -fx-border-width: 1; -fx-border-radius: 20;
                                                 -fx-background-radius: 20; -fx-padding: 3 10 3 10;">
                                        <Label text="⚙️  MODERATION MODE"
                                               style="-fx-text-fill: #f87171; -fx-font-size: 10px; -fx-font-weight: 700;"/>
                                    </HBox>
                                </HBox>

                                <ScrollPane fx:id="genMessagesScroll"
                                            fitToWidth="true" VBox.vgrow="ALWAYS" hbarPolicy="NEVER"
                                            style="-fx-background-color: transparent;
                                                   -fx-background: transparent;
                                                   -fx-border-color: transparent;">
                                    <VBox fx:id="genMessagesBox" spacing="4"
                                          style="-fx-background-color: transparent; -fx-padding: 14 0 14 0;"/>
                                </ScrollPane>

                                <HBox spacing="10" alignment="CENTER"
                                      style="-fx-padding: 12 16 12 16;
                                             -fx-background-color: #0a1525;
                                             -fx-background-radius: 0 0 0 16;
                                             -fx-border-color: #1e3a5a transparent transparent transparent;
                                             -fx-border-width: 1 0 0 0;">
                                    <TextField fx:id="genInputField"
                                               promptText="Write a message to students…"
                                               HBox.hgrow="ALWAYS"
                                               style="-fx-background-color: #111d30;
                                                      -fx-text-fill: #e2e8f0;
                                                      -fx-prompt-text-fill: #2d4060;
                                                      -fx-border-color: #1e3a5a;
                                                      -fx-border-width: 1;
                                                      -fx-border-radius: 10;
                                                      -fx-background-radius: 10;
                                                      -fx-font-size: 13px;
                                                      -fx-padding: 11 16 11 16;"/>
                                    <Button fx:id="genSendBtn" text="➤"
                                            style="-fx-background-color: linear-gradient(to right,#06b6d4,#0891b2);
                                                   -fx-text-fill: white; -fx-font-size: 14px;
                                                   -fx-font-weight: bold; -fx-background-radius: 10;
                                                   -fx-cursor: hand; -fx-padding: 10 20;
                                                   -fx-effect: dropshadow(gaussian,#06b6d460,10,0.4,0,2);"/>
                                </HBox>
                            </VBox>

                            <!-- Online sidebar -->
                            <VBox prefWidth="220" minWidth="200"
                                  style="-fx-background-color: #080f1e;
                                         -fx-border-color: #1e3a5a;
                                         -fx-border-width: 1 1 1 0;
                                         -fx-border-radius: 0 16 16 0;
                                         -fx-background-radius: 0 16 16 0;">

                                <HBox alignment="CENTER_LEFT" spacing="8"
                                      style="-fx-padding: 14 16 14 16;
                                             -fx-background-color: #0a1828;
                                             -fx-background-radius: 0 16 0 0;
                                             -fx-border-color: transparent transparent #1e3a5a transparent;
                                             -fx-border-width: 0 0 1 0;">
                                    <Label text="👥" style="-fx-font-size: 13px;"/>
                                    <Label text="Active Users"
                                           style="-fx-text-fill: #94a3b8; -fx-font-size: 12px; -fx-font-weight: 700;"/>
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Label fx:id="genOnlineCount" text="0 online"
                                           style="-fx-text-fill: #22c55e; -fx-font-size: 10px; -fx-font-weight: 700;
                                                  -fx-padding: 2 8 2 8;
                                                  -fx-background-color: rgba(34,197,94,0.12);
                                                  -fx-background-radius: 10;
                                                  -fx-border-color: rgba(34,197,94,0.3);
                                                  -fx-border-width: 1; -fx-border-radius: 10;"/>
                                </HBox>

                                <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" hbarPolicy="NEVER"
                                            style="-fx-background-color: transparent;
                                                   -fx-background: transparent; -fx-border-color: transparent;">
                                    <VBox fx:id="genOnlineBox" spacing="2"
                                          style="-fx-background-color: transparent; -fx-padding: 8 4 8 4;"/>
                                </ScrollPane>

                                <!-- Rank legend -->
                                <VBox spacing="5"
                                      style="-fx-padding: 12 14 16 14;
                                             -fx-border-color: #1e3a5a transparent transparent transparent;
                                             -fx-border-width: 1 0 0 0;
                                             -fx-background-color: #060c18;
                                             -fx-background-radius: 0 0 16 0;">
                                    <Label text="RANK COLOURS"
                                           style="-fx-text-fill: #1e3a5a; -fx-font-size: 9px; -fx-font-weight: 700;"/>
                                    <HBox spacing="8" alignment="CENTER_LEFT">
                                        <Circle radius="5" style="-fx-fill: #fbbf24;"/>
                                        <Label text="Legend" style="-fx-text-fill: #334155; -fx-font-size: 11px;"/>
                                    </HBox>
                                    <HBox spacing="8" alignment="CENTER_LEFT">
                                        <Circle radius="5" style="-fx-fill: #a78bfa;"/>
                                        <Label text="Champion" style="-fx-text-fill: #334155; -fx-font-size: 11px;"/>
                                    </HBox>
                                    <HBox spacing="8" alignment="CENTER_LEFT">
                                        <Circle radius="5" style="-fx-fill: #60a5fa;"/>
                                        <Label text="Expert" style="-fx-text-fill: #334155; -fx-font-size: 11px;"/>
                                    </HBox>
                                    <HBox spacing="8" alignment="CENTER_LEFT">
                                        <Circle radius="5" style="-fx-fill: #f97316;"/>
                                        <Label text="Advanced" style="-fx-text-fill: #334155; -fx-font-size: 11px;"/>
                                    </HBox>
                                    <HBox spacing="8" alignment="CENTER_LEFT">
                                        <Circle radius="5" style="-fx-fill: #34d399;"/>
                                        <Label text="Skilled" style="-fx-text-fill: #334155; -fx-font-size: 11px;"/>
                                    </HBox>
                                    <HBox spacing="8" alignment="CENTER_LEFT">
                                        <Circle radius="5" style="-fx-fill: #94a3b8;"/>
                                        <Label text="Learner" style="-fx-text-fill: #334155; -fx-font-size: 11px;"/>
                                    </HBox>
                                    <HBox spacing="8" alignment="CENTER_LEFT">
                                        <Circle radius="5" style="-fx-fill: #6b7280;"/>
                                        <Label text="Beginner" style="-fx-text-fill: #334155; -fx-font-size: 11px;"/>
                                    </HBox>
                                </VBox>
                            </VBox>
                        </HBox>
                    </center>
                </BorderPane>
            </Tab>

        </TabPane>
    </center>

</BorderPane>
