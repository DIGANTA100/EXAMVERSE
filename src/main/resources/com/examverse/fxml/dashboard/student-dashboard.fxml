<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane fx:id="rootPane"
            xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.examverse.controller.dashboard.StudentDashboardController"
            stylesheets="@../../css/student-dashboard.css"
            styleClass="root-pane">

    <!-- ====================================================
         LEFT SIDEBAR
         ==================================================== -->
    <left>
        <VBox fx:id="sidebarPane" styleClass="sidebar-pane" spacing="5">
            <padding>
                <Insets top="28" right="0" bottom="28" left="0"/>
            </padding>

            <!-- Brand -->
            <VBox styleClass="sidebar-brand" alignment="CENTER" spacing="6">
                <VBox.margin><Insets bottom="26"/></VBox.margin>
                <Label text="EXAM" styleClass="brand-title"/>
                <Label text="VERSE" styleClass="brand-title-accent"/>
                <Label text="STUDENT PORTAL" styleClass="brand-subtitle"/>
            </VBox>

            <Separator styleClass="sidebar-separator"/>

            <!-- Navigation -->
            <VBox styleClass="sidebar-nav" spacing="6">
                <VBox.margin><Insets top="18"/></VBox.margin>

                <Button fx:id="dashboardBtn"  text="📊  Dashboard"
                        styleClass="sidebar-btn" onAction="#handleDashboard"/>

                <Button fx:id="myExamsBtn"    text="📚  My Exams"
                        styleClass="sidebar-btn" onAction="#handleMyExams"/>

                <Button fx:id="practiceBtn"   text="💪  Practice"
                        styleClass="sidebar-btn" onAction="#handlePractice"/>

                <Button fx:id="resultsBtn"    text="📈  Results"
                        styleClass="sidebar-btn" onAction="#handleResults"/>

                <Button fx:id="profileBtn"    text="👤  Profile"
                        styleClass="sidebar-btn" onAction="#handleProfile"/>

                <Button fx:id="aiAssistantBtn" text="🤖  AI Assistant"
                        styleClass="sidebar-btn" onAction="#handleAiAssistant"/>

                <Button fx:id="contestsBtn"   text="⚔️  Contests"
                        styleClass="sidebar-btn" onAction="#handleContests"/>
            </VBox>

            <Region VBox.vgrow="ALWAYS"/>

            <!-- Bottom: logout — fixed spacing ensures button is always reachable -->
            <VBox styleClass="sidebar-bottom" spacing="10">
                <VBox.margin><Insets top="8" bottom="16"/></VBox.margin>
                <Separator styleClass="sidebar-separator"/>
                <Button fx:id="logoutBtn" text="🚪  Logout"
                        styleClass="sidebar-btn-logout" onAction="#handleLogout"/>
            </VBox>
        </VBox>
    </left>

    <!-- ====================================================
         CENTER CONTENT
         ==================================================== -->
    <center>
        <VBox styleClass="content-container">

            <!-- Top Header Bar -->
            <HBox styleClass="header-bar" alignment="CENTER_LEFT" spacing="20">
                <padding>
                    <Insets top="18" right="28" bottom="18" left="28"/>
                </padding>

                <!-- Welcome text -->
                <VBox spacing="2" HBox.hgrow="ALWAYS">
                    <Label fx:id="welcomeLabel" text="Welcome back, Student 👋"
                           styleClass="welcome-label"/>
                    <Label fx:id="dateTimeLabel" text="Monday, Jan 01 2026 • 12:00:00 AM"
                           styleClass="datetime-label"/>
                </VBox>

                <!-- Header right: notification bell + avatar -->
                <HBox alignment="CENTER" spacing="12">

                    <!-- Notification bell with badge -->
                    <StackPane>
                        <!-- fx:id="notificationBtn" wires the bell to the controller -->
                        <Button fx:id="notificationBtn" text="🔔"
                                styleClass="notification-btn"
                                onAction="#handleNotification"/>
                        <Label fx:id="notificationBadge" text="0"
                               styleClass="notification-badge" visible="false"/>
                    </StackPane>

                    <!-- Profile avatar button (shows initials, opens profile) -->
                    <Button fx:id="avatarBtn" text="?"
                            styleClass="avatar-btn"/>
                </HBox>
            </HBox>

            <!-- Dynamic content area -->
            <ScrollPane fx:id="contentScrollPane" fitToWidth="true"
                        styleClass="content-scroll" VBox.vgrow="ALWAYS">
                <VBox fx:id="contentPane" styleClass="content-pane"/>
            </ScrollPane>

        </VBox>
    </center>

</BorderPane>
